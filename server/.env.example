# ──────────────────────────────────────────────────────────────
# AGROVET INVENTORY SYSTEM — ENVIRONMENT VARIABLES
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
#

# ── SERVER ──────────────────────────────────────────────────────
# NODE_ENV determines logging level, error details, and feature toggles
NODE_ENV=development

# PORT on which the Express server listens
PORT=5000

# CLIENT_URL is the frontend origin for CORS whitelisting
# Development: http://localhost:5173 (Vite default)
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# ── DATABASE ────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Get this from MongoDB Atlas → Connect → Driver → Node.js → Connection String
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrovetdb?retryWrites=true&w=majority

# ── JWT AUTHENTICATION ──────────────────────────────────────────
# JWT_SECRET: Generate a 64-char random hex string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate_64char_random_hex>

# Access token expiration time (short-lived, used in Authorization header)
JWT_EXPIRES_IN=15m

# JWT_REFRESH_SECRET: Another 64-char random hex string for refresh tokens
JWT_REFRESH_SECRET=<generate_64char_random_hex>

# Refresh token expiration time (long-lived, stored in HttpOnly cookie)
JWT_REFRESH_EXPIRES_IN=7d

# ── GOOGLE GEMINI AI ────────────────────────────────────────────
# Get your free API key from: https://aistudio.google.com/
# 1. Visit https://aistudio.google.com/
# 2. Sign in with your Google account
# 3. Click "Get API key" → "Create API key in new project"
# 4. Copy the key here
GEMINI_API_KEY=<your_google_ai_studio_api_key>

# Gemini model to use (as of 2024, 'gemini-1.5-pro' is the recommended version)
GEMINI_MODEL=gemini-1.5-pro

# ── CLOUDINARY (Image Storage) ──────────────────────────────────
# Get credentials from: https://cloudinary.com/console
# 1. Sign up for free account at cloudinary.com
# 2. Go to Settings → API Keys
# 3. Copy Cloud Name, API Key, and API Secret
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# ── EMAIL CONFIGURATION (Nodemailer / Gmail SMTP) ─────────────────
# Using Gmail for transactional emails (alerts, password reset)
# Instructions: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Your Gmail address (e.g., agrovet.system@gmail.com)
EMAIL_USER=<your_gmail_address>

# Gmail App Password (NOT your regular password)
# To generate: https://myaccount.google.com/apppasswords
# 1. Enable 2-Step Verification on your Google account
# 2. Go to App passwords
# 3. Select "Mail" → "Windows Computer" (or your OS)
# 4. Copy the 16-character password
EMAIL_PASS=<gmail_app_password>

# Sender display name for emails
EMAIL_FROM=AgroVet System <noreply@agrovet.co.ke>

# ── RATE LIMITING ───────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS: Time window for rate limiting (in milliseconds)
# 900000 = 15 minutes
RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX: Max requests allowed per window for general endpoints
# Stricter limits applied to /auth routes automatically
RATE_LIMIT_MAX=100

# ── CHATBOT USAGE LIMITS ────────────────────────────────────────
# Different daily message limits by role to control Gemini API costs

# Max chat messages a farmer can send per calendar day
CHAT_MESSAGES_PER_DAY_FARMER=20

# Max chat messages an admin can send per calendar day
CHAT_MESSAGES_PER_DAY_ADMIN=100

# ── ALERT THRESHOLDS ────────────────────────────────────────────
# STOCK_ALERT_CRON_SCHEDULE: Cron expression for when to run stock/expiry checks
# Format: minute hour day month day-of-week
# '0 7 * * *' = Every day at 7:00 AM
# Use (crontab.guru)[https://crontab.guru] to generate custom expressions
STOCK_ALERT_CRON_SCHEDULE=0 7 * * *

# Days before expiry date to trigger 'expiry_warning' alert
# Set to 30 to be alerted 30 days before products expire
EXPIRY_ALERT_DAYS_BEFORE=30
